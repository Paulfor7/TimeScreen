{
  "name": "timescreen",
  "version": "1.0.2",
  "description": "TimeScreen 本地专注与时间记录",
  "main": "electron/main.cjs",
  "author": "TimeScreen",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "dist": "npm run build && electron-builder --win portable"
  },
  "type": "module",
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.51.0"
  },
  "build": {
    "appId": "com.timescreen.desktop",
    "productName": "TimeScreen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TimeScreen-${version}.exe"
    }
  }
}
